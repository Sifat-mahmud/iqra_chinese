<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:layout_marginBottom="12dp">
    <TextView android:id="@+id/tvLvlName" android:layout_width="56dp"
        android:layout_height="wrap_content" android:text="HSK 1"
        android:textSize="12sp" android:textStyle="bold" android:textColor="@color/gold"/>
    <ProgressBar android:id="@+id/pbLvl"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp" android:layout_height="5dp" android:layout_weight="1"
        android:progressDrawable="@drawable/pb_mastery" android:layout_marginHorizontal="8dp"/>
    <TextView android:id="@+id/tvLvlPct" android:layout_width="80dp"
        android:layout_height="wrap_content" android:text="0/0 (0%)"
        android:textSize="10sp" android:textColor="@color/text_muted" android:gravity="end"/>
</LinearLayout>
