<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Back button -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <ImageButton android:id="@+id/btnAuthBack"
                android:layout_width="40dp" android:layout_height="40dp"
                android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="@color/text_secondary"/>
        </LinearLayout>

        <!-- Logo / icon area -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🀄" android:textSize="56sp"
            android:layout_marginTop="16dp" android:layout_marginBottom="8dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Iqra Chinese" android:textSize="13sp"
            android:textColor="@color/text_muted" android:layout_marginBottom="32dp"/>

        <!-- Title -->
        <TextView android:id="@+id/tvAuthTitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Create Account" android:textSize="24sp" android:textStyle="bold"
            android:textColor="@color/gold" android:layout_marginBottom="24dp"/>

        <!-- Email -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Email" android:textSize="12sp" android:textColor="@color/text_muted"
            android:layout_marginBottom="4dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundColor="@color/bg2" app:boxStrokeColor="@color/gold"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="you@example.com"
                android:inputType="textEmailAddress"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Password" android:textSize="12sp" android:textColor="@color/text_muted"
            android:layout_marginBottom="4dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundColor="@color/bg2" app:boxStrokeColor="@color/gold"
            app:endIconMode="password_toggle"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Min 6 characters"
                android:inputType="textPassword"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirm password (sign-up only) -->
        <TextView android:id="@+id/tvConfirmLabel"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Confirm Password" android:textSize="12sp" android:textColor="@color/text_muted"
            android:layout_marginBottom="4dp"/>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundColor="@color/bg2" app:boxStrokeColor="@color/gold"
            app:endIconMode="password_toggle"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Re-enter password"
                android:inputType="textPassword"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Forgot password (sign-in only) -->
        <TextView android:id="@+id/tvForgotPassword"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Forgot password?" android:textSize="12sp"
            android:textColor="@color/sapphire" android:gravity="end"
            android:layout_marginBottom="16dp"
            android:paddingVertical="4dp"/>

        <!-- Error text -->
        <TextView android:id="@+id/tvAuthError"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:textColor="@color/ruby"
            android:layout_marginBottom="12dp" android:visibility="gone"
            android:lineSpacingMultiplier="1.4"/>

        <!-- Progress -->
        <ProgressBar android:id="@+id/authProgress"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" android:visibility="gone"
            android:indeterminateTint="@color/gold"/>

        <!-- Submit -->
        <Button android:id="@+id/btnAuthSubmit"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Create Account" android:textSize="15sp"
            android:textColor="@color/black" android:backgroundTint="@color/gold"
            android:layout_marginBottom="16dp"/>

        <!-- OR divider -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:background="@color/bg3"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="  or  " android:textSize="12sp" android:textColor="@color/text_muted"/>
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:background="@color/bg3"/>
        </LinearLayout>

        <!-- Google Sign-In button -->
        <Button android:id="@+id/btnGoogleSignIn"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Continue with Google"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/bg2"
            android:drawableStart="@drawable/ic_google"
            android:drawablePadding="10dp"
            android:layout_marginBottom="20dp"/>

        <!-- Toggle sign-up / sign-in -->
        <TextView android:id="@+id/tvAuthToggle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Already have an account? Sign in"
            android:textSize="13sp" android:textColor="@color/sapphire"
            android:paddingVertical="8dp"/>

        <!-- Legal note -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Your progress is backed up to Firebase once per day. You can study without an account — sign-up is optional."
            android:textSize="11sp" android:textColor="@color/text_muted"
            android:gravity="center" android:layout_marginTop="24dp"
            android:lineSpacingMultiplier="1.5"/>

    </LinearLayout>
</ScrollView>
