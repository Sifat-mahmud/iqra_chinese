<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ── Setup screen ── -->
    <ScrollView android:id="@+id/layoutSetup" android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="14dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                <Button android:id="@+id/btnBack" android:layout_width="wrap_content"
                    android:layout_height="40dp" android:text="←" android:backgroundTint="@color/bg3"
                    android:textColor="@color/text_secondary"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="TEST" android:textSize="16sp"
                    android:textStyle="bold" android:textColor="@color/text_primary"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:scrollbars="none" android:layout_marginBottom="12dp">
                <LinearLayout android:id="@+id/llPills" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:orientation="horizontal"/>
            </HorizontalScrollView>

            <!-- Type tabs -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">
                <Button android:id="@+id/tabWords" android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="Words" android:textStyle="bold"
                    android:backgroundTint="@color/gold" android:textColor="@color/black"
                    android:layout_marginEnd="6dp"/>
                <Button android:id="@+id/tabSentences" android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="Sentences"
                    android:backgroundTint="@color/bg3" android:textColor="@color/text_secondary"/>
            </LinearLayout>

            <!-- Mode -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/bg2" app:cardCornerRadius="14dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="TEST MODE" android:textSize="9sp" android:textColor="@color/text_muted"
                        android:letterSpacing="0.1" android:layout_marginBottom="10dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <Button android:id="@+id/btnMeaning" android:layout_width="0dp" android:layout_height="40dp"
                            android:layout_weight="1" android:text="Char → Meaning"
                            android:backgroundTint="@color/gold" android:textColor="@color/black"
                            android:textSize="11sp" android:layout_marginEnd="8dp"/>
                        <Button android:id="@+id/btnCharacter" android:layout_width="0dp" android:layout_height="40dp"
                            android:layout_weight="1" android:text="Meaning → Char"
                            android:backgroundTint="@color/bg3" android:textColor="@color/text_secondary"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button android:id="@+id/btnStart" android:layout_width="match_parent"
                android:layout_height="52dp" android:text="🚀  Start Test  (20 items)"
                android:textSize="15sp" android:textStyle="bold"
                android:backgroundTint="@color/gold" android:textColor="@color/black"/>
        </LinearLayout>
    </ScrollView>

    <!-- ── Active test screen ── -->
    <LinearLayout android:id="@+id/layoutTest" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical"
        android:padding="14dp" android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
            <Button android:id="@+id/btnTestBack" android:layout_width="wrap_content"
                android:layout_height="36dp" android:text="←" android:backgroundTint="@color/bg3"
                android:textColor="@color/text_secondary"/>
            <TextView android:id="@+id/tvCounter" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="1/20" android:textSize="12sp"
                android:textColor="@color/text_muted" android:fontFamily="monospace" android:gravity="center"/>
            <TextView android:id="@+id/tvScore" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="✓0  ✗0"
                android:textSize="12sp" android:textColor="@color/text_secondary"/>
        </LinearLayout>

        <ProgressBar android:id="@+id/pbTest" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="4dp"
            android:progressDrawable="@drawable/pb_daily" android:layout_marginBottom="14dp"/>

        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@color/bg2" app:cardCornerRadius="20dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:padding="20dp" android:gravity="center">
                <TextView android:id="@+id/tvQuestion" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text=""
                    android:textSize="58sp" android:textStyle="bold"
                    android:textColor="@color/text_primary" android:gravity="center"
                    android:layout_marginBottom="8dp"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center"
                    android:layout_marginTop="10dp">
                    <ImageButton android:id="@+id/btnSpeak"
                        android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_speak"
                        android:background="@drawable/bg_chip_gold"
                        android:padding="10dp"
                        android:contentDescription="Speak"
                        android:layout_marginEnd="10dp"/>
                    <ImageButton android:id="@+id/btnSpeakSlow"
                        android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_speak_slow"
                        android:background="@drawable/bg_hint"
                        android:padding="10dp"
                        android:contentDescription="Speak slowly"/>
                </LinearLayout>

                <TextView android:id="@+id/tvSub" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text=""
                    android:textSize="16sp" android:textColor="@color/violet"
                    android:textStyle="italic" android:gravity="center" android:minHeight="22dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <EditText android:id="@+id/etTest" android:layout_width="match_parent"
            android:layout_height="52dp" android:background="@drawable/bg_input"
            android:textColor="@color/text_primary" android:textSize="15sp"
            android:hint="Type answer…" android:textColorHint="@color/text_muted"
            android:imeOptions="actionDone" android:inputType="text"
            android:paddingHorizontal="16dp" android:layout_marginBottom="10dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnTestCheck" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="Submit" android:textStyle="bold"
                android:backgroundTint="@color/gold" android:textColor="@color/black" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnTestSkip" android:layout_width="80dp" android:layout_height="48dp"
                android:text="Skip →" android:backgroundTint="@color/bg3"
                android:textColor="@color/text_secondary" android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ── Result screen ── -->
    <ScrollView android:id="@+id/layoutResult" android:layout_width="match_parent"
        android:layout_height="match_parent" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp" android:gravity="center">
            <TextView android:id="@+id/tvResultEmoji" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="🏆" android:textSize="62sp"
                android:layout_marginBottom="12dp"/>
            <TextView android:id="@+id/tvResultPct" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0%" android:textSize="38sp"
                android:textStyle="bold" android:textColor="@color/gold" android:layout_marginBottom="6dp"/>
            <TextView android:id="@+id/tvResultDetail" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0 correct · 0 wrong"
                android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_marginBottom="6dp"/>
            <TextView android:id="@+id/tvResultMsg" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text=""
                android:textSize="15sp" android:textStyle="bold" android:textColor="@color/violet"
                android:layout_marginBottom="20dp"/>
            <LinearLayout android:id="@+id/llWrong" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginBottom="20dp"/>
            <Button android:id="@+id/btnTryAgain" android:layout_width="match_parent"
                android:layout_height="52dp" android:text="Try Again" android:textStyle="bold"
                android:backgroundTint="@color/gold" android:textColor="@color/black"
                android:layout_marginBottom="10dp"/>
            <Button android:id="@+id/btnResultBack" android:layout_width="match_parent"
                android:layout_height="48dp" android:text="← Back to Setup"
                android:backgroundTint="@color/bg3" android:textColor="@color/text_secondary"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
