<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="SETTINGS" android:textSize="10sp" android:textColor="@color/text_muted"
            android:letterSpacing="0.12" android:layout_marginBottom="12dp"/>

        <!-- Firebase account card -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/bg2" app:cardCornerRadius="14dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ACCOUNT &amp; CLOUD BACKUP" android:textSize="9sp"
                    android:textColor="@color/sapphire" android:letterSpacing="0.1"
                    android:layout_marginBottom="10dp"/>
                <TextView android:id="@+id/tvAccountStatus"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Not signed in" android:textSize="13sp"
                    android:textColor="@color/text_primary" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tvBackupStatus"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Sign in to enable cloud backup" android:textSize="11sp"
                    android:textColor="@color/text_muted" android:layout_marginBottom="14dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <Button android:id="@+id/btnSignInOut"
                        android:layout_width="0dp" android:layout_height="40dp"
                        android:layout_weight="1" android:layout_marginEnd="8dp"
                        android:text="Sign In / Register"
                        android:textSize="12sp" android:textColor="@color/black"
                        android:backgroundTint="@color/gold"/>
                    <Button android:id="@+id/btnSyncNow"
                        android:layout_width="wrap_content" android:layout_height="40dp"
                        android:text="Sync Now" android:textSize="12sp"
                        android:textColor="@color/sapphire"
                        android:backgroundTint="#1A5B9CF6"
                        android:enabled="false"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/bg2" app:cardCornerRadius="14dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:id="@+id/tvXP" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="⚡ 0 XP  ·  Level 1"
                    android:textSize="16sp" android:textStyle="bold" android:textColor="@color/gold"
                    android:layout_marginBottom="6dp"/>
                <TextView android:id="@+id/tvStreak" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="🔥 1 day streak"
                    android:textSize="13sp" android:textColor="@color/amber" android:layout_marginBottom="6dp"/>
                <TextView android:id="@+id/tvBest" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="🏆 Best test: 0%"
                    android:textSize="13sp" android:textColor="@color/sapphire" android:layout_marginBottom="10dp"/>
                <TextView android:id="@+id/tvDaily" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Today: 0m 00s / 30m"
                    android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginBottom="6dp"/>
                <ProgressBar android:id="@+id/pbDaily"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="5dp"
                    android:progressDrawable="@drawable/pb_daily" android:max="100"
                    android:layout_marginBottom="14dp"/>

                <!-- Daily study goal slider -->
                <TextView android:id="@+id/tvGoalLabel"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Daily study goal: 30 min"
                    android:textSize="12sp" android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp"/>
                <SeekBar android:id="@+id/seekGoal"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:min="5" android:max="60" android:progress="30"
                    android:progressTint="@color/gold" android:thumbTint="@color/gold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="5 min                                                              60 min"
                    android:textSize="9sp" android:textColor="@color/text_muted"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Display toggles -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/bg2" app:cardCornerRadius="14dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DISPLAY" android:textSize="9sp" android:textColor="@color/text_muted"
                    android:letterSpacing="0.1" android:layout_marginBottom="10dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingVertical="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Show Pinyin" android:textSize="14sp" android:textStyle="bold"
                            android:textColor="@color/text_primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Romanized pronunciation in cards"
                            android:textSize="11sp" android:textColor="@color/text_muted" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchPinyin" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="true"
                        android:thumbTint="@color/black" android:trackTint="@color/gold"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingVertical="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Show Meaning" android:textSize="14sp" android:textStyle="bold"
                            android:textColor="@color/text_primary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="English translation while practicing"
                            android:textSize="11sp" android:textColor="@color/text_muted" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchMeaning" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:checked="true"
                        android:thumbTint="@color/black" android:trackTint="@color/gold"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Alarm card -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/bg2" app:cardCornerRadius="14dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ALARM &amp; REMINDERS" android:textSize="9sp"
                    android:textColor="@color/ruby" android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"/>

                <!-- Phase status -->
                <TextView android:id="@+id/tvAlarmPhase"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="⏰ Hourly alarm active — cannot be disabled"
                    android:textSize="13sp" android:textColor="@color/ruby"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginBottom="6dp"/>

                <TextView android:id="@+id/tvAlarmCountdown"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="⏱ Next check in: --:--"
                    android:textSize="12sp" android:textColor="@color/sapphire"
                    android:layout_marginBottom="12dp"/>

                <!-- Phase legend -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="🔔 Hours 0–12: notification with 1× snooze\n🚨 Hours 12–24: full alarm with 1× snooze — no dismiss"
                    android:textSize="11sp" android:textColor="@color/text_muted"
                    android:lineSpacingMultiplier="1.5"
                    android:layout_marginBottom="14dp"/>

                <!-- Day start time picker -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Day starts at" android:textSize="12sp"
                    android:textColor="@color/text_secondary" android:layout_marginBottom="8dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <NumberPicker android:id="@+id/npHour"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=" : " android:textSize="20sp" android:textColor="@color/gold"
                        android:textStyle="bold"/>

                    <NumberPicker android:id="@+id/npMinute"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <Button android:id="@+id/btnSaveDayStart"
                        android:layout_width="wrap_content" android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:text="Save" android:textSize="12sp"
                        android:textColor="@color/black" android:backgroundTint="@color/gold"/>
                </LinearLayout>

                <TextView android:id="@+id/tvDayStartConfirm"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="" android:textSize="11sp" android:textColor="@color/jade"
                    android:layout_marginBottom="4dp"/>

                <!-- TTS section -->
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/bg3" android:layout_marginVertical="10dp"/>

                <TextView android:id="@+id/tvTtsInfo" android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔊 TTS: Loading..."
                    android:textSize="12sp" android:textColor="@color/jade"
                    android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tvDeviceOs" android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 Device: Detecting..."
                    android:textSize="12sp" android:textColor="@color/text_secondary"
                    android:layout_marginBottom="10dp"/>
                <LinearLayout android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnTestTts"
                        android:layout_width="wrap_content" android:layout_height="36dp"
                        android:text="🔊 Test TTS" android:textSize="11sp"
                        android:textColor="@color/black" android:backgroundTint="@color/gold"
                        android:layout_marginEnd="8dp"/>
                    <Button android:id="@+id/btnRetryTts"
                        android:layout_width="wrap_content" android:layout_height="36dp"
                        android:text="🔄 Retry" android:textSize="11sp"
                        android:textColor="@color/jade" android:backgroundTint="#1A3ECF8E"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Danger zone -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/bg2" app:cardCornerRadius="14dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DANGER ZONE" android:textSize="9sp" android:textColor="@color/ruby"
                    android:letterSpacing="0.1" android:layout_marginBottom="12dp"/>
                <Button android:id="@+id/btnResetProgress" android:layout_width="match_parent"
                    android:layout_height="44dp" android:text="Reset Progress"
                    android:backgroundTint="#1AE8455A" android:textColor="@color/ruby"
                    android:layout_marginBottom="8dp"/>
                <Button android:id="@+id/btnResetAll" android:layout_width="match_parent"
                    android:layout_height="44dp" android:text="Reset Everything"
                    android:backgroundTint="@color/bg3" android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- About -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/bg2" app:cardCornerRadius="14dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Iqra Chinese HSK 1–6" android:textSize="15sp" android:textStyle="bold"
                    android:textColor="@color/gold" android:layout_marginBottom="6dp"/>
                <TextView android:id="@+id/tvAppInfo" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Loading…"
                    android:textSize="12sp" android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.6"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
