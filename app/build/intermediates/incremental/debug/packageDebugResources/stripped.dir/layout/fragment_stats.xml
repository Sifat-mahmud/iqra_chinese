<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="STATISTICS" android:textSize="10sp" android:textColor="@color/text_muted"
            android:letterSpacing="0.12" android:layout_marginBottom="12dp"/>

        <!-- Top stat row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_stat" android:padding="10dp" android:layout_marginEnd="6dp">
                <TextView android:id="@+id/tvAttempts" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textSize="24sp" android:textStyle="bold" android:textColor="@color/gold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ATTEMPTS" android:textSize="9sp" android:textColor="@color/text_muted"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_stat" android:padding="10dp" android:layout_marginEnd="6dp">
                <TextView android:id="@+id/tvAccuracy" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0%"
                    android:textSize="24sp" android:textStyle="bold" android:textColor="@color/jade"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ACCURACY" android:textSize="9sp" android:textColor="@color/text_muted"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_stat" android:padding="10dp">
                <TextView android:id="@+id/tvMastered" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0"
                    android:textSize="24sp" android:textStyle="bold" android:textColor="@color/violet"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PERFECT" android:textSize="9sp" android:textColor="@color/text_muted"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp">
            <TextView android:id="@+id/tvXP" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="⚡ 0 XP"
                android:textSize="13sp" android:textStyle="bold" android:textColor="@color/gold"
                android:background="@drawable/bg_stat" android:padding="10dp"
                android:gravity="center" android:layout_marginEnd="6dp"/>
            <TextView android:id="@+id/tvStreak" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="🔥 1"
                android:textSize="13sp" android:textStyle="bold" android:textColor="@color/amber"
                android:background="@drawable/bg_stat" android:padding="10dp"
                android:gravity="center" android:layout_marginEnd="6dp"/>
            <TextView android:id="@+id/tvBest" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="🏆 0%"
                android:textSize="12sp" android:textStyle="bold" android:textColor="@color/sapphire"
                android:background="@drawable/bg_stat" android:padding="10dp" android:gravity="center"/>
        </LinearLayout>

        <!-- Daily -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/bg2" app:cardCornerRadius="14dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Today's Study"
                        android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_secondary"/>
                    <TextView android:id="@+id/tvDaily" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0m 00s / 30m"
                        android:textSize="11sp" android:textColor="@color/jade" android:fontFamily="monospace"/>
                </LinearLayout>
                <ProgressBar android:id="@+id/pbDaily"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="5dp"
                    android:progressDrawable="@drawable/pb_daily" android:max="100"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Weekly bar chart -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/bg2" app:cardCornerRadius="14dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="WORDS PASSED – LAST 7 DAYS" android:textSize="9sp"
                    android:textColor="@color/text_muted" android:letterSpacing="0.1"
                    android:layout_marginBottom="10dp"/>
                <com.iqra.chinese.ui.BarChartView android:id="@+id/barChart"
                    android:layout_width="match_parent" android:layout_height="130dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Time studied chart -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/bg2" app:cardCornerRadius="14dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="TIME STUDIED (MIN) – LAST 7 DAYS" android:textSize="9sp"
                    android:textColor="@color/text_muted" android:letterSpacing="0.1"
                    android:layout_marginBottom="10dp"/>
                <com.iqra.chinese.ui.BarChartView android:id="@+id/timeChart"
                    android:layout_width="match_parent" android:layout_height="130dp"/>
                <TextView android:id="@+id/tvTotalTimeStudied"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Total: 0h 0m" android:textSize="11sp"
                    android:textColor="@color/text_secondary" android:gravity="end"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Pass vs Fail -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/bg2" app:cardCornerRadius="14dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PASS VS FAIL" android:textSize="9sp" android:textColor="@color/text_muted"
                    android:letterSpacing="0.1" android:layout_marginBottom="8dp"/>
                <ProgressBar android:id="@+id/pbPassFail"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="16dp"
                    android:progressDrawable="@drawable/pb_pass_fail"
                    android:max="100" android:layout_marginBottom="6dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/tvPass" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="✓ 0"
                        android:textSize="12sp" android:textColor="@color/jade"/>
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                    <TextView android:id="@+id/tvFail" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="✗ 0"
                        android:textSize="12sp" android:textColor="@color/ruby"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Level progress -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/bg2" app:cardCornerRadius="14dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="HSK LEVEL MASTERY" android:textSize="9sp"
                    android:textColor="@color/text_muted" android:letterSpacing="0.1"
                    android:layout_marginBottom="10dp"/>
                <LinearLayout android:id="@+id/llLevelProgress" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Recent attempts -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/bg2" app:cardCornerRadius="14dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="RECENT ATTEMPTS" android:textSize="9sp"
                    android:textColor="@color/text_muted" android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp"/>
                <LinearLayout android:id="@+id/llRecent" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
