<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp">

        <!-- Topbar -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
            <ImageButton android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp"
                android:src="@drawable/ic_back" android:background="@drawable/bg_pill"
                android:padding="8dp"/>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <TextView android:id="@+id/tvXpTop" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="⚡ 0"
                android:textSize="12sp" android:textStyle="bold" android:textColor="@color/gold"/>
        </LinearLayout>

        <!-- Level pills -->
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none" android:layout_marginBottom="12dp">
            <LinearLayout android:id="@+id/llPills" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="horizontal"/>
        </HorizontalScrollView>

        <!-- Word card -->
        <androidx.cardview.widget.CardView android:id="@+id/cardWord"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/bg2" app:cardCornerRadius="20dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp" android:gravity="center">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                    <TextView android:id="@+id/tvHskBadge" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="HSK 1"
                        android:textSize="10sp" android:textStyle="bold"
                        android:background="@drawable/bg_badge" android:paddingHorizontal="8dp" android:paddingVertical="3dp"
                        android:textColor="@color/gold"/>
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                    <TextView android:id="@+id/tvCounter" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="1/0"
                        android:textSize="11sp" android:textColor="@color/text_muted" android:fontFamily="monospace"/>
                </LinearLayout>

                <ProgressBar android:id="@+id/pbProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="3dp"
                    android:progressDrawable="@drawable/pb_word" android:layout_marginBottom="16dp"/>

                <TextView android:id="@+id/tvChar" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="你好"
                    android:textSize="72sp" android:textStyle="bold"
                    android:textColor="@color/text_primary" android:layout_marginBottom="8dp"
                    android:letterSpacing="-0.03"/>

                <TextView android:id="@+id/tvPinyin" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text=""
                    android:textSize="17sp" android:textColor="@color/violet"
                    android:textStyle="italic" android:minHeight="24dp" android:layout_marginBottom="4dp"/>

                <TextView android:id="@+id/tvMeaning" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text=""
                    android:textSize="15sp" android:textColor="@color/text_secondary"
                    android:minHeight="20dp" android:layout_marginBottom="10dp"/>

                                <!-- Speak buttons -->
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="8dp">
                    <ImageButton android:id="@+id/btnSpeak"
                        android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_speak"
                        android:background="@drawable/bg_chip_gold"
                        android:padding="10dp"
                        android:contentDescription="Speak"
                        android:layout_marginEnd="10dp"/>
                    <ImageButton android:id="@+id/btnSpeakSlow"
                        android:layout_width="44dp" android:layout_height="44dp"
                        android:src="@drawable/ic_speak_slow"
                        android:background="@drawable/bg_hint"
                        android:padding="10dp"
                        android:contentDescription="Speak slowly"/>
                </LinearLayout>

<TextView android:id="@+id/tvTone" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="3rd Tone"
                    android:textSize="10sp" android:textStyle="bold"
                    android:background="@drawable/bg_badge" android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp" android:layout_marginBottom="10dp"/>

                <TextView android:id="@+id/tvReview" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="⟳ 0 review"
                    android:textSize="10sp" android:textStyle="bold" android:textColor="@color/amber"
                    android:background="@drawable/bg_chip_amber" android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp" android:visibility="gone" android:layout_marginBottom="8dp"/>

                <LinearLayout android:id="@+id/llDots" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:orientation="horizontal"
                    android:layout_marginBottom="4dp"/>

                <TextView android:id="@+id/tvPassFail" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text=""
                    android:textSize="10sp" android:textColor="@color/text_muted"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Hint -->
        <TextView android:id="@+id/tvHint" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text=""
            android:textSize="13sp" android:textColor="@color/violet"
            android:background="@drawable/bg_hint" android:padding="12dp"
            android:gravity="center" android:layout_marginBottom="10dp" android:visibility="gone"/>

        <!-- Input -->
        <EditText android:id="@+id/etAnswer" android:layout_width="match_parent"
            android:layout_height="52dp" android:background="@drawable/bg_input"
            android:textColor="@color/text_primary" android:textSize="15sp"
            android:hint="Type the English meaning…" android:textColorHint="@color/text_muted"
            android:imeOptions="actionDone" android:inputType="text"
            android:paddingHorizontal="16dp" android:layout_marginBottom="10dp"/>

        <!-- Buttons -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="10dp">
            <Button android:id="@+id/btnCheck" android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="Check ✓" android:textStyle="bold"
                android:backgroundTint="@color/gold" android:textColor="@color/black"
                android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnHint" android:layout_width="48dp" android:layout_height="48dp"
                android:text="💡" android:backgroundTint="@color/bg3" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btnSkip" android:layout_width="72dp" android:layout_height="48dp"
                android:text="Skip →" android:backgroundTint="@color/bg3"
                android:textColor="@color/text_secondary" android:textSize="11sp"/>
        </LinearLayout>

        <Button android:id="@+id/btnAddGroup" android:layout_width="match_parent"
            android:layout_height="44dp" android:text="📌  Add to Group"
            android:textSize="12sp" android:backgroundTint="@color/bg3"
            android:textColor="@color/text_secondary" android:layout_marginBottom="16dp"/>
    </LinearLayout>
</ScrollView>
